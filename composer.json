{
    "name": "dmk/t3twig",
    "description": "Extend rn_base for using twig templates instead of marker templates",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3 CMS",
        "twig",
        "template"
    ],
    "homepage": "http://www.dmk-ebusiness.de/",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Eric Hertwig",
            "email": "eric.hertwig@dmk-ebusiness.de",
            "role": "Developer"
        },
        {
            "name": "René Nitzsche",
            "email": "nitzsche@dmk-ebusiness.de",
            "role": "Developer"
        },
        {
            "name": "Michael Wagner",
            "email": "michael.wagner@dmk-ebusiness.de",
            "role": "Developer"
        }
    ],
    "require": {
		"php": "^8.0",
        "typo3/cms-core": "^11.5 || ^12.4",
        "digedag/rn-base": "~1.18",
        "twig/twig": "~3.14"
    },
    "require-dev": {
        "mikey179/vfsstream": "^1.6",
        "php-parallel-lint/php-parallel-lint": "^1.2",
        "friendsofphp/php-cs-fixer": "^3.3",
		"phpcompatibility/php-compatibility": "^9.3.5",
		"typo3/testing-framework": "^6.0 || ^7.0",
		"phpunit/phpunit": "^9.0",
		"phpstan/phpstan": "^1.1",
		"saschaegerer/phpstan-typo3": "^1.9",
		"phpstan/extension-installer": "*",
		"dmk/phpstan-rnbase": "*",
		"phpspec/prophecy-phpunit": "^2.0",
		"ssch/typo3-rector": "^2.5",
		"rector/rector": "^1.0",
		"captainhook/captainhook": "^5.10"
	},
    "suggest": {
        "twig/extensions": "Common additional features for Twig that do not directly belong in core. See @Documentation/reference/extensions/ThirdParty.md"
    },
    "autoload": {
        "psr-4": {
            "DMK\\T3twig\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DMK\\T3twig\\Tests\\": "Tests"
        }
    },
    "support": {
        "email": "dev@dmk-ebusiness.de"
    },
    "replace": {
        "typo3-ter/t3twig": "*"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
		"preferred-install": {
			"*": "dist"
		},
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "phpstan/extension-installer": true,
            "cweagans/composer-patches": true
        }
	},
    "scripts": {
		"post-autoload-dump": [
			"[ -e .Build/bin/captainhook ] && .Build/bin/captainhook install -f || echo 'CaptainHook missing, skip install.'"
		],
		"runqa": [
			"@fix",
			"@lint",
			"@test"
		],
        "lint:php": [
			"[ -e .Build/bin/parallel-lint ] || composer update",
			"echo 'parallel-lint fails with a exception if executed inside the vendor/dmk/t3twig folder'",
			"[ ! -e ../../autoload.php ] || mv ../../autoload.php ../../autoload.php.bak",
			".Build/bin/parallel-lint --exclude .Build ./",
			"[ ! -e ../../autoload.php.bak ] || mv ../../autoload.php.bak ../../autoload.php"
        ],
        "lint": [
            "@lint:php"
        ],
        "test:phpcs": [
            "[ -e .Build/bin/php-cs-fixer ] || composer update --ansi",
            ".Build/bin/php-cs-fixer fix -v --dry-run --diff  --ansi"
        ],
		"test:rector": [
			"[ -e .Build/bin/rector ] || composer update",
			".Build/bin/rector process --dry-run"
		],
		"test:phpcompatibility": [
			"[ -e .Build/bin/phpcs ] || composer update",
			".Build/bin/phpcs --ignore=.Build/*,Resources/Public/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.0-8.4"
		],
        "test:phpstan": [
            "[ -e .Build/bin/phpstan ] || composer update --ansi",
            ".Build/bin/phpstan analyse -c phpstan.neon --memory-limit=512M --ansi"
        ],
        "test:phpunit": [
            "[ -e .Build/bin/phpunit ] || composer update --ansi",
            "export TYPO3_PATH_WEB=$PWD/.Build/Web && .Build/bin/phpunit -c phpunit.xml.dist --colors=always"
        ],
        "test": [
            "@test:phpcs",
			"@test:rector",
			"@test:phpcompatibility",
            "@test:phpstan",
            "@test:phpunit"
        ],
        "fix:phpcs": [
            "[ -e .Build/bin/php-cs-fixer ] || composer update --ansi",
            ".Build/bin/php-cs-fixer fix -v"
        ],
		"fix:rector": [
			"[ -e .Build/bin/rector ] || composer update --ansi",
			".Build/bin/rector process"
		],
		"fix": [
			"@fix:rector",
            "@fix:phpcs"
        ]
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "t3twig",
            "web-dir": ".Build/Web",
            "app-dir": ".Build"
        }
    }
}
